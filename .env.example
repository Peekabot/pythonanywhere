# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
CREW_CHAT_ID=your_group_chat_id_here

# Claude AI (Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub Actions auto-deploy
